# ========================================================
# SUDOKU DUEL - REALTIME ENVIRONMENT CONFIGURATION
# ========================================================
#
# İki oyuncunun internet üzerinden (Vercel deployment) gerçek zamanlı
# aynı maçta oynaması için Supabase Realtime kullanılır.
#
# 1. https://supabase.com adresinden ücretsiz bir proje oluşturun.
# 2. Project Settings -> API bölümünden aşağıdaki iki değeri kopyalayın.
# 3. Bu değerler Vercel Dashboard -> Settings -> Environment Variables alanına eklenmelidir.
#
# NOT: Eğer bu değişkenler tanımlanmazsa, uygulama yerel ortamda
# aynı bilgisayardaki iki tarayıcı sekmesi arasında (Local BroadcastChannel)
# otomatik olarak sıfır yapılandırmayla çalışmaya devam eder.
#

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
